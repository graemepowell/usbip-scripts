# Copy this file to .env (gitignored) or set these as Windows environment variables.

# IP address or hostname of the Raspberry Pi / USB/IP server
USBIP_HOST=192.168.1.100

# SSH username on the USB/IP server (must have passwordless sudo for systemctl usbipd)
USBIP_USER=pi

# Path to the SSH private key used to connect to the server
USBIP_SSH_KEY=%USERPROFILE%\.ssh\usbipd_key

# Optional: Path to usbip.exe on Windows (defaults to C:\Program Files\USBip\usbip.exe)
# USBIP_EXE=C:\Program Files\USBip\usbip.exe
